---
interface Props {
  name: 'training' | 'encyclopedia' | 'culture' | 'health' | 'home';
  large?: boolean;
}
const { name, large = false } = Astro.props;
---
<span class:list={['menu-icon', { large }]} style={`--icon-url: url('/icons/${name}.svg')`} aria-hidden="true"></span>
<style>
  .menu-icon { display:inline-block; width:20px; height:20px; flex-shrink:0; background:currentColor; mask:var(--icon-url) center / contain no-repeat; -webkit-mask:var(--icon-url) center / contain no-repeat; }
  .menu-icon.large { width:40px; height:40px; }
</style>
