---
import { render } from 'astro:content';
import { getAllDocuments } from '../../lib/documents';
import '../../styles/document.css';
import MenuIcon from '../../components/MenuIcon.astro';

export async function getStaticPaths() {
  const documents = await getAllDocuments();
  return documents.map((doc) => ({
    params: { slug: `${doc.collection.folder}/${doc.entry.id}` },
    props: { doc }
  }));
}

const { doc } = Astro.props;
const { entry, collection } = doc;
const { Content } = await render(entry);
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} | 한국 반려동물 연구원</title>
  </head>
  <body>
    <header class="document-header">
      <a class="document-brand" href="/">KPAI · 한국 반려동물 연구원</a>
      <nav aria-label="문서 메뉴">
        <a href={collection.route}><MenuIcon name={collection.icon} />{collection.name} 목록</a>
        <a href="/"><MenuIcon name="home" />홈</a>
      </nav>
    </header>
    <main class="document-shell">
      <div class="document-meta">
        <span>{collection.label}</span>
        {entry.data.category && <span>{entry.data.category}</span>}
      </div>
      <article class="document-content">
        <Content />
      </article>
      <footer class="document-footer">
        <a href={collection.route}>← 목록으로 돌아가기</a>
        <span>한국 반려동물 연구원</span>
      </footer>
    </main>
  </body>
</html>
<style>
  .document-header nav a { display:inline-flex; align-items:center; gap:7px; }
</style>
