---
import { COLLECTIONS, getAllDocuments, groupByCategory } from '../lib/documents';
import '../styles/archive.css';
import MenuIcon from '../components/MenuIcon.astro';

const documents = await getAllDocuments();
const categories = [...groupByCategory(documents).entries()].sort((a, b) => b[1].length - a[1].length);
---
<html lang="ko">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>한국 반려동물 연구원</title></head>
  <body>
    <header class="site-header"><a class="brand" href="/"><span class="brand-mark">KPAI</span>한국 반려동물 연구원</a><nav class="main-nav">{COLLECTIONS.map((c) => <a href={c.route}><MenuIcon name={c.icon} />{c.name}</a>)}</nav></header>
    <main class="archive-main">
      <p class="eyebrow">KOREA PET ANIMAL INSTITUTE · 2026</p>
      <h1>함께 살아가는<br />방식을 기록합니다.</h1>
      <p class="archive-intro">한국 반려동물 연구원은 반려동물과 사람이 맺는 관계, 그 관계를 둘러싼 생활과 문화를 연구하고 기록하는 지식 아카이브입니다.</p>
      <div class="home-grid">
        {COLLECTIONS.map((c) => (
          <a class="home-card" href={c.route}>
            <span class="eyebrow">{c.label} · {documents.filter((d) => d.collection.key === c.key).length} DOCUMENTS</span>
            <h2><MenuIcon name={c.icon} large />{c.name}</h2>
          </a>
        ))}
      </div>

      <div class="archive-toolbar"><span>전체 {documents.length}편 · {categories.length}개 카테고리</span></div>

      {categories.map(([category, docs]) => (
        <section class="category-section">
          <h2 class="category-heading">{category}<small>{docs.length}편</small></h2>
          <ol class="document-list">
            {docs.map((doc) => (
              <li>
                <a href={doc.href}>
                  <span>{doc.collection.label}</span>
                  <strong>{doc.entry.data.title}</strong>
                  <small>{doc.collection.name}</small>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>
  </body>
</html>
